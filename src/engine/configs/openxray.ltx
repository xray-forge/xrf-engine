[environment]
$scheme = $openxray_environment
dynamic_sun_dir = false
sun_dir_azimuth = 0.0

[gameplay]
$scheme = $openxray_gameplay
actor_death_camera = freelook

[lua_scripting]
$scheme = $openxray_lua_scripting
allow_nil_conversion = false
allow_escape_sequences = false

[compatibility]
$scheme = $openxray_compatibility
game_mode = cop
