; Dynamic zone: respawn points wait longer and respawn fewer squads, and squads at or near bases are not hunted.

[respawn]
; Game seconds a respawn point waits between respawn attempts.
idle = 86400

[respawn_idle]
; Respawn wait of single smart terrains, by name, in game seconds.

[population]
; Factors of the squads a respawn section may have alive, rounded half up. A share of one squad is a chance per
; respawn attempt.
stalker_factor = 0.5
monster_factor = 0.75

[hunting]
; Metres from a base smart terrain within which squads are not hunted; squads assigned to a base never are.
base_protection_radius = 75
